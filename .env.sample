# Copy this file to .env and fill in your values
# Never commit .env to version control

# NVD API key — get one free at https://nvd.nist.gov/developers/request-an-api-key
# Without this, NVD requests are rate-limited to 5 req/30s (very slow for large ranges)
NVD_API_KEY=your_nvd_api_key_here

# BEA API key — optional, only needed if fetching I-O tables via API
# Get one at https://apps.bea.gov/api/signup/
BEA_API_KEY=your_bea_api_key_here

# SEC EDGAR user-agent — required by SEC fair-access policy
# Use your name and email: "FirstName LastName email@example.com"
SEC_USER_AGENT=Your Name email@example.com
