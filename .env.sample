# Copy to .env, fill in values, and never commit it.

# NVD key: https://nvd.nist.gov/developers/request-an-api-key; omitting it triggers strict rate limits.
NVD_API_KEY=your_nvd_api_key_here

# Optional BEA key: https://apps.bea.gov/api/signup/.
BEA_API_KEY=your_bea_api_key_here

# Required SEC user-agent: "FirstName LastName email@example.com".
SEC_USER_AGENT=Your Name email@example.com

# Optional DeepSeek key for summaries: https://platform.deepseek.com/api_keys.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
